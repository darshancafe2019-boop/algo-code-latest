# =============================================================================
# QUANT.OS GLOBAL MARKET DATA & EXECUTION ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE SERVER & OPERATING MODES
# -----------------------------------------------------------------------------
PORT=5050
HOST=127.0.0.1
DEBUG=False
TRADING_MODE=PAPER

# Frontend & Gateway Routing Endpoints
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:5050
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:5051
BACKEND_INTERNAL_URL=http://127.0.0.1:5050
GATEWAY_URL=http://127.0.0.1:5051
APP_PUBLIC_URL=http://localhost:3100

# -----------------------------------------------------------------------------
# 2. INDIA MARKET — UPSTOX OFFICIAL V2/V3 API
# -----------------------------------------------------------------------------
ENABLE_INDIA_MARKET=true
ENABLE_INDIA_FNO=true
INDIA_BROKER=UPSTOX
UPSTOX_TRADING_ENABLED=false
UPSTOX_PAPER_MODE=true
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3100/api/upstox/callback
UPSTOX_ACCESS_TOKEN=
UPSTOX_ANALYTICS_TOKEN=

# -----------------------------------------------------------------------------
# 3. CRYPTO SPOT / FUTURES — BINANCE OFFICIAL CCXT & WEBSOCKET FEED
# -----------------------------------------------------------------------------
ENABLE_BINANCE=true
BINANCE_TESTNET=true
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# -----------------------------------------------------------------------------
# 4. CRYPTO OPTIONS — DELTA EXCHANGE (INDIA / GLOBAL)
# -----------------------------------------------------------------------------
ENABLE_DELTA_OPTIONS=true
DELTA_TRADING_ENABLED=false
DELTA_REST_URL=https://api.india.delta.exchange
DELTA_PUBLIC_WS_URL=wss://public-socket.india.delta.exchange
DELTA_API_KEY=
DELTA_API_SECRET=

# -----------------------------------------------------------------------------
# 5. US & GLOBAL LICENSED MARKET DATA PROVIDERS (OPTIONAL)
# -----------------------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
TRADING_ECONOMICS_API_KEY=
FRED_API_KEY=

# -----------------------------------------------------------------------------
# 6. INTERNAL MARKET DATA GATEWAY SECURITY
# -----------------------------------------------------------------------------
MARKET_GATEWAY_SECRET=
MARKET_GATEWAY_URL=http://127.0.0.1:5051

# -----------------------------------------------------------------------------
# 7. TELEGRAM ALERTS & COMMAND BOT
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COMMANDS_ENABLED=false
TELEGRAM_RATE_LIMIT_SEC=1.0
TELEGRAM_MAX_RETRIES=3
TELEGRAM_TIMEOUT_SEC=8.0
SEND_STARTUP_MESSAGE=true
SEND_TRADE_ALERTS=true
SEND_ERROR_ALERTS=true
SEND_HEARTBEAT_MESSAGES=false

# -----------------------------------------------------------------------------
# 8. INSTITUTIONAL AUTHENTICATION, RBAC, 2FA & DEMO MODE
# -----------------------------------------------------------------------------
AUTH_BOOTSTRAP_ENABLED=true
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_EMAIL=admin@algotrading.local
AUTH_SESSION_SECRET=
AUTH_TOTP_ENCRYPTION_KEY=
NEXT_PUBLIC_AUTH_DEMO_MODE=false
NEXT_PUBLIC_DEMO_USERNAME=admin
NEXT_PUBLIC_DEMO_PASSWORD=

# -----------------------------------------------------------------------------
# 9. DATABASE PERSISTENCE (NEON POSTGRESQL & SQLITE FALLBACK)
# -----------------------------------------------------------------------------
DATABASE_PROVIDER=postgresql
# Dedicated application runtime connection (role: quantos_app, pooled)
DATABASE_URL=postgresql://quantos_app:<APP_PASSWORD>@ep-purple-sound-b37ajw1j-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Administrative / migration owner connection (role: neondb_owner)
DATABASE_MIGRATION_URL=postgresql://neondb_owner:<MIGRATION_PASSWORD>@ep-purple-sound-b37ajw1j.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SQLITE_DATABASE_PATH=data/trading_bot.db
DB_PATH=data/trading_bot.db
BACKUP_PATH=backup/
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL_HOURS=24
DB_INTEGRITY_CHECK_ENABLED=true

# -----------------------------------------------------------------------------
# 10. TRANSACTIONAL EMAIL DELIVERY (RESEND & SMTP FALLBACK)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
AUTH_EMAIL_FROM=onboarding@resend.dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# 11. BOT IDENTIFICATION & EXECUTION SAFETY FLAGS
# -----------------------------------------------------------------------------
BOT_NAME=BTC Trading Bot
EXCHANGE_NAME=Binance
LIVE_TRADING_ENABLED=false
MASTER_LIVE_TRADING=false
REQUIRE_SIGNAL_APPROVAL=true
SIGNAL_THRESHOLD_PCT=75.0
TEST_MODE=false
PAPER_TRADING=true
VERBOSE_LOGGING=true
FORCE_TEST_SIGNAL=false
TEST_TELEGRAM_ONLY=false

# -----------------------------------------------------------------------------
# 12. SERVER-SIDE HARD SAFETY & RISK LIMITS
# -----------------------------------------------------------------------------
MAX_POSITION_SIZE=1.0
MAX_ORDER_VALUE=10000.0
MAX_DAILY_LOSS=500.0
MAX_TOTAL_EXPOSURE=25000.0
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=20
MAX_MARKET_DATA_AGE_SECONDS=60
RISK_PCT_PER_TRADE=0.02
MAX_CONCURRENT_POSITIONS=1
DAILY_LOSS_LIMIT_PCT=-0.20
STOP_LOSS_METHOD=tighter
SWING_LOOKBACK_CANDLES=5
TAKE_PROFIT_METHOD=risk_reward
FIXED_STOP_LOSS_PCT=0.10
FIXED_RISK_REWARD_RATIO=3.0
KILL_SWITCH_FILE=kill_switch.flag

# -----------------------------------------------------------------------------
# 13. TECHNICAL INDICATORS & CONFLUENCE DEFAULTS
# -----------------------------------------------------------------------------
SYMBOL=BTC/USDT
TIMEFRAME=5m
EMA_FAST_CROSS=9
EMA_SLOW_CROSS=20
EMA_SUPPORT=50
EMA_TREND_FILTER=200
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
VP_LOOKBACK_DAYS=7
VP_VALUE_AREA_PCT=0.70
VP_BUFFER_PCT=0.02
VP_BIN_SIZE_USDT=25.0
ALLOW_SHORTS=true
USE_EMA9_FILTER=false
USE_RSI_FILTER=false
USE_DAILY_BIAS_FILTER=false
RSI_TIMEFRAME=5m
RSI_LENGTH=14
CONFLUENCE_THRESHOLD=0.75
REQUIRED_CONFLUENCE_COUNT=3
MAX_INDICATOR_LIMIT=12

# -----------------------------------------------------------------------------
# 14. LOGGING & DIAGNOSTICS
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE=logs/trading_bot.log
SAVE_ALL_CANDLES=false
SAVE_SIGNALS=true
SAVE_TRADES=true
PRINT_INDICATORS=true
PRINT_SIGNALS=true
PRINT_ORDER_DETAILS=true
HEARTBEAT_MINUTES=5
CHECK_INTERVAL_MINS=1
