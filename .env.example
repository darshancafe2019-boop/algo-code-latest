# =============================================================================
# QUANT.OS GLOBAL MARKET DATA PIPELINE ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================

# Server Port & Mode
PORT=3100
TRADING_MODE=PAPER
UPSTOX_TRADING_ENABLED=false
UPSTOX_PAPER_MODE=true

# India — Upstox Official V2/V3 API
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3100/api/upstox/callback
UPSTOX_ACCESS_TOKEN=
UPSTOX_ANALYTICS_TOKEN=

# Crypto — Binance Official CCXT / WebSocket Feed
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# US / Global Licensed Providers (Optional / As Licensed)
POLYGON_API_KEY=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
TRADING_ECONOMICS_API_KEY=
FRED_API_KEY=

# Market Data Gateway Internal Security
MARKET_GATEWAY_SECRET=
MARKET_GATEWAY_URL=http://127.0.0.1:5051

# Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
