# Algorithmic Trading Platform — Environment Configuration Template
# (DO NOT commit actual API keys or secrets to version control)

# Server Port & Binding
PORT=5050
HOST=127.0.0.1
DEBUG=False

# Database Configuration
DATABASE_PATH=trading_bot.db
SQLITE_WAL_MODE=True

# Broker & Exchange API Credentials (Placeholders)
BINANCE_API_KEY=YOUR_BINANCE_API_KEY_HERE
BINANCE_API_SECRET=YOUR_BINANCE_API_SECRET_HERE
DERIBIT_CLIENT_ID=YOUR_DERIBIT_CLIENT_ID_HERE
DERIBIT_CLIENT_SECRET=YOUR_DERIBIT_CLIENT_SECRET_HERE
ZERODHA_API_KEY=NOT_CONFIGURED
ZERODHA_API_SECRET=NOT_CONFIGURED
ZERODHA_ACCESS_TOKEN=NOT_CONFIGURED

# Angel One SmartAPI (Free tier — NSE/BSE live data)
ANGELONE_API_KEY=NOT_CONFIGURED
ANGELONE_CLIENT_ID=NOT_CONFIGURED
ANGELONE_TOTP_SECRET=NOT_CONFIGURED
ANGELONE_PIN=NOT_CONFIGURED

# Global Equity / Forex Data Providers
TWELVE_DATA_API_KEY=NOT_CONFIGURED
POLYGON_API_KEY=NOT_CONFIGURED
DATABENTO_API_KEY=NOT_CONFIGURED

# Economic Calendar & Macro Data
TRADING_ECONOMICS_API_KEY=NOT_CONFIGURED

# Market Data Gateway Configuration
MARKET_GATEWAY_PORT=5051
MARKET_GATEWAY_SECRET=changeme-set-a-strong-random-secret-here
MARKET_GATEWAY_URL=http://127.0.0.1:5051

# Redis (optional — gateway uses in-memory fallback if unavailable)
REDIS_URL=redis://localhost:6379/1

# TimescaleDB / PostgreSQL (for production OHLCV candle storage)
TIMESCALE_URL=postgresql://localhost:5432/quantos_market_data

# Telegram Alert Integration (Optional)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# Risk Management Controls
GLOBAL_KILL_SWITCH=False
MAX_DAILY_DRAWDOWN_PCT=5.0
MAX_SINGLE_ASSET_EXPOSURE_PCT=30.0
CONFLUENCE_THRESHOLD=0.75

# Frontend Next.js API Proxy Target
BACKEND_API_URL=http://127.0.0.1:5050
NEXT_PUBLIC_APP_ENV=production
