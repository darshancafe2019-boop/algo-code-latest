{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "predev": "node -e \"const fs=require('fs');try{fs.rmSync('.next/server',{recursive:true,force:true});}catch(e){}\"",
    "dev": "next dev",
    "dev:all": "python ../run_system.py",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs');try{fs.rmSync('.next',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true});console.log('.next and tsbuildinfo cleaned');}catch(e){}\"",
    "test": "tsc --noEmit && next lint",
    "test:smoke": "node ./tests/static_assets_smoke_test.js",
    "test:upstox": "tsx ../scripts/test_upstox_complete.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@swc/helpers": "^0.5.13",
    "@tanstack/react-query": "^5.59.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.453.0",
    "next": "14.2.35",
    "openai": "^7.5.0",
    "protobufjs": "^8.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.86.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
