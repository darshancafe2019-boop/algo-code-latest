{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": "./frontend",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "frontend/next-env.d.ts",
    "frontend/declarations.d.ts",
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "frontend/.next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "frontend/node_modules",
    ".venv",
    ".venv_py39",
    "dist",
    "build"
  ]
}
